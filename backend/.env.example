# Origenes extra del frontend (cualquier localhost ya esta permitido).
# CORS_ORIGINS=["https://retenciones.miempresa.com"]
# Dias de diferencia aceptados entre la fecha de ARCA y la del asiento.
# TOLERANCIA_DIAS=5
# EMPRESA=PICCININI Y ASOCIADOS S.A.

# --- Bots (Conexiones) ---
# false = la ventana de Chrome se ve (necesario para el doble factor de ARCA y el captcha de Xubio).
# HEADLESS=false
# Nombre del servicio de ARCA tal como aparece en el buscador del portal.
# ARCA_SERVICIO=Mis Retenciones
# Cada cuantos minutos se le avisa al portal de ARCA para que no cierre la sesion (~15 min sin actividad).
# ARCA_MANTENER_PORTAL_MIN=9
# Cuenta de Xubio del estudio (opcional): con las dos, el bot escribe el ingreso solo.
# XUBIO_USUARIO=
# XUBIO_CLAVE=
# Palabras que identifican las cuentas de retenciones en el plan de cuentas de Xubio.
# XUBIO_CUENTAS_RETENCIONES=retencion,retenciones,percepcion,percepciones
# Direccion de la pantalla de Libro Mayor de Xubio (vacia = el bot la busca en el menu).
# XUBIO_URL_LIBRO_MAYOR=

# --- Usuario ---
# No hay ingreso: la página principal manda X-Usuario-Id / -Nombre / -Roles. Sin ellos, este usuario.
# USUARIO_POR_DEFECTO_ID=local
# USUARIO_POR_DEFECTO_NOMBRE=Usuario local
# empleado, supervisor o los dos separados por coma.
# USUARIO_POR_DEFECTO_ROLES=supervisor
