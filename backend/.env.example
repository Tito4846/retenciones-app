# Origenes extra del frontend (cualquier localhost ya esta permitido).
# CORS_ORIGINS=["https://retenciones.miempresa.com"]
# Dias de diferencia aceptados entre la fecha de ARCA y la del asiento.
# TOLERANCIA_DIAS=5
# EMPRESA=PICCININI Y ASOCIADOS S.A.

# --- Bots (Conexiones) ---
# false = la ventana de Chrome se ve (necesario para el doble factor de ARCA y el captcha de Xubio).
# HEADLESS=false
# Nombre del servicio de ARCA tal como aparece en el buscador del portal.
# ARCA_SERVICIO=Mis Retenciones
# Cada cuantos minutos se le avisa al portal de ARCA para que no cierre la sesion (~15 min sin actividad).
# ARCA_MANTENER_PORTAL_MIN=9
# Cuenta de Xubio del estudio (opcional): con las dos, el bot escribe el ingreso solo.
# XUBIO_USUARIO=
# XUBIO_CLAVE=
# Palabras que identifican las cuentas de retenciones en el plan de cuentas de Xubio.
# XUBIO_CUENTAS_RETENCIONES=retencion,retenciones,percepcion,percepciones
# Direccion de la pantalla de Libro Mayor de Xubio (vacia = el bot la busca en el menu).
# XUBIO_URL_LIBRO_MAYOR=

# --- Ingreso ---
# La cuenta principal (supervisor): da de alta a los demás y les resetea la contraseña.
# CUENTA_PRINCIPAL=tito.rodriguez@estudiopiccinini.com.ar
# true = los supervisores tienen que usar segundo factor (Google Authenticator). Por defecto es opcional.
# DOSFA_SUPERVISORES=false
# Firma de los tokens y cifrado de los segundos factores. Vacía = se genera sola en datos/.secreto.
# Si la cambiás se cierran todas las sesiones y hay que volver a registrar el segundo factor.
# SECRET_KEY=
# Dónde se abre el front (para el enlace de configuración inicial que sale en la consola).
# FRONT_URL=http://localhost:4200
# Minutos de vida del token de acceso, minutos sin uso hasta pedir de nuevo la contraseña y
# horas máximas de una sesión.
# ACCESO_MIN=10
# INACTIVIDAD_MIN=60
# SESION_HORAS=12
# Intentos fallidos seguidos antes de bloquear la cuenta, y por cuántos minutos.
# INTENTOS_MAX=5
# BLOQUEO_MIN=15
# Cookie de sesión solo por HTTPS (los navegadores la aceptan en http://localhost).
# COOKIE_SECURE=true
